# The mock engine needs nothing. Copy to .env to try the live engine.
# Keys stay on the dev server (vite.config.ts proxy); they are never bundled.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Live mode is off by default. Set to "live" (or open http://localhost:5180/?engine=live).
VITE_ENGINE=mock
# VITE_OPENROUTER_MODEL=anthropic/claude-opus-5
# VITE_TYPESAFE_MODEL=jev-latest
