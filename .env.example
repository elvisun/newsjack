# newsjack local development
#
# Copy values into .env. The .env file is gitignored.

# News search. Required for live news_search source.
MEDIALYST_API_KEY=
MEDIALYST_API_BASE=https://medialyst.ai/api
MEDIALYST_NEWS_PATH=/v1/news/search

# Optional Medialyst MCP. Prefer:
#   newsjack login
# The root .mcp.json uses the saved Newsjack credential or MEDIALYST_API_KEY.
# Recommended scopes: news:search, media_lists:read, media_lists:write.

# Optional local store override. Defaults to ~/.local/share/newsjack/monitor.db.
NEWSJACK_STORE=

# X uses xurl's own OAuth state, not an env token.
# Run: xurl auth oauth2 login
