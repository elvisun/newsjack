# newsjack local development
#
# Copy values into .env. The .env file is gitignored.

# Optional. Enables the live news_search source and journalist enrichment.
# Without it, news search falls back to host web search and journalist lists stay local.
MEDIALYST_API_KEY=
MEDIALYST_API_BASE=https://medialyst.ai/api
MEDIALYST_NEWS_PATH=/v1/news/search

# Prefer:
#   newsjack login
# Recommended access: news search and journalist enrichment.

# Optional local store override. Defaults to ~/.local/share/newsjack/monitor.db.
NEWSJACK_STORE=

# Optional X API source coverage. Newsjack calls the X API directly.
# Use one bearer token variable; aliases exist for compatibility.
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
