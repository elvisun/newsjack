# Contentful CMS (required for /insights blog)
# The space may contain other content types; this site renders only newsjackBlogPost.
# Set this to the Contentful space ID.
CONTENTFUL_SPACE_ID=
# Set this to a Content Delivery API token for the space.
CONTENTFUL_ACCESS_TOKEN=

# Neon Postgres (install telemetry)
POSTGRES_URL=
